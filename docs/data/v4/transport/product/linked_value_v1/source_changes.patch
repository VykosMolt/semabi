+                if self.mode == "duplicate_link" and index == 0:
+                    duplicate = len(nodes)
+                    nodes.append(Node(duplicate, root, "link", value))
+                    controls[duplicate] = {**controls[link],
+                                           "destination": "https://synthetic.invalid/alternate/0"}
+                    self.record_actions[duplicate] = index
+            self.tokens = {node.i: (node.parent, node.role, node.name) for node in nodes}
+        else:
+            self.editor_reads += 1
+            parent = len(nodes)
+            nodes.append(Node(parent, 0, "group", ""))
+
+            def add_context():
+                node = len(nodes)
+                nodes.append(Node(node, parent, "button", "#11"))
+                controls[node] = {"role": "button", "label": "#11", "input_type": "", "form": None,
+                                  "disabled": False, "readonly": False}
+                return node
+
+            def add_field():
+                node = len(nodes)
+                descriptor = self.linked_descriptor()
+                nodes.append(Node(node, parent, "textbox", descriptor["label"], value=self.editor_value))
+                controls[node] = {**descriptor, "form": None, "disabled": False, "readonly": False}
+                return node
+
+            # Reorder siblings on each read so the baseline must resolve the
+            # descriptor afresh while retained element identity stays stable.
+            if self.editor_reads % 2:
+                context, field = add_context(), add_field()
+            else:
+                field, context = add_field(), add_context()
+            self.current_parent, self.current_field = parent, field
+            self.tokens = {parent: ("parent", 0), field: ("field", self.field_generation),
