+    environment.write_bytes(b"SYNTHETIC_SETTING=unchanged\n")
+    environment.chmod(0o600)
+    manifest = {"application": "memos", "version": "0.30.0", "port": 19222,
+                "command": [str(app / "bin/memos")], "cwd": str(app),
+                "pid": 123, "started_unix": 1.0}
+    (app / "deployment.json").write_text(json.dumps(manifest))
+    state = {"running": True, "calls": []}
+
+    def running(app, manifest):
+        return state["running"]
+
+    def stop(app, manifest):
+        state["calls"].append("stop")
+        state["running"] = False
+
+    def start(app, manifest):
+        state["calls"].append("start")
+        state["running"] = True
+        manifest["pid"] += 1
+        manifest["started_unix"] += 1
+
+    monkeypatch.setattr(helper, "running", running)
+    monkeypatch.setattr(helper, "stop", stop)
+    monkeypatch.setattr(helper, "start", start)
+    return app, manifest, state
