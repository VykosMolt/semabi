+@pytest.mark.parametrize("verdict", ["SUPPORTED", "REFUTED", "POSSIBLE", "UNKNOWN",
+                                     "NOT_APPLICABLE"])
+def test_incomplete_aggregation_reaches_recursive_identity(verdict):
+    from copy import deepcopy
+    from semabi.compiler.v4 import consequence as csq
+
+    op, world = rule({"?z": BERTH}), state(obj("A"), obj("B"), obj("C"))
+    complete = binding.solve(op, (), world, {})
+    partial = binding.solve(op, (), world, {}, limit=2)
+    part = _part(csq.SUPPORTED)
+    part.identity = _part(verdict)
+    part.identity.kind = csq.IDENTITY
+    part.identity.detail = f"identity evidence: {verdict}"
+    part.identity.observed = ("the observed identity",)
+    original = deepcopy(part)
+
+    control = csq._aggregate(_part(csq.NOT_APPLICABLE), [part], complete)
+    got = csq._aggregate(_part(csq.NOT_APPLICABLE), [part], partial)
+    assert control.verdict == csq.SUPPORTED and control.identity.verdict == verdict
+    assert not control.binding_truncated and not control.identity.binding_truncated
+    assert got.verdict == csq.POSSIBLE and got.binding_truncated
+    assert got.identity.verdict == (csq.POSSIBLE if verdict in
+                                    (csq.SUPPORTED, csq.REFUTED, csq.POSSIBLE) else csq.UNKNOWN)
+    assert got.identity.binding_truncated
+    assert got.identity.observed == part.identity.observed
+    assert f"representative evidence: {part.identity.detail}" in got.identity.detail
+    assert f"SUPPORTED={int(verdict == csq.SUPPORTED)}" in got.identity.detail
+    assert "2 assignments retained; 1 representative consequences evaluated" in got.identity.detail
+    assert part == original
+
