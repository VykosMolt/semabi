+def test_incomplete_aggregation_preserves_only_observed_evidence(verdicts, complete_verdict,
+                                                               counts):
+    from copy import deepcopy
+    from semabi.compiler.v4 import consequence as csq
+
+    op, world = rule({"?z": BERTH}), state(obj("A"), obj("B"), obj("C"))
+    complete = binding.solve(op, (), world, {})
+    partial = binding.solve(op, (), world, {}, limit=2)
+    parts = [_part(v) for v in verdicts]
+    for i, part in enumerate(parts):
+        part.detail = f"observed representative {i}: {part.verdict}"
+        part.expected, part.observed = f"expected {i}", (f"observed {i}",)
+        part.context, part.feature_node = (("representative", i),), i
+    untouched_parts, untouched_binding = deepcopy(parts), partial.to_json()
+
+    control = csq._aggregate(_part(csq.NOT_APPLICABLE), parts, complete)
+    got = csq._aggregate(_part(csq.NOT_APPLICABLE), parts, partial)
+    assert control.verdict == complete_verdict and not control.binding_truncated
+    assert got.verdict == (csq.POSSIBLE if sum(counts[:3]) else csq.UNKNOWN)
+    assert got.binding_truncated
+    for name in ("subject", "context", "held_before", "feature_node", "action_local",
+                 "correspondence", "admissible", "layers", "observed", "expected",
+                 "binding_evidence"):
+        assert getattr(got, name) == getattr(control, name)
+    labels = (csq.SUPPORTED, csq.REFUTED, csq.POSSIBLE, csq.UNKNOWN, csq.NOT_APPLICABLE)
+    expected_counts = ", ".join(f"{label}={count}" for label, count in zip(labels, counts))
+    expected_detail = (f"the binding search is incomplete: 2 assignments retained; "
+                       f"{len(parts)} representative consequences evaluated; "
+                       f"observed consequence verdicts: {expected_counts}")
+    if parts:
+        representative = next(p for p in parts if p.context == control.context)
+        expected_detail += f"; representative evidence: {representative.detail}"
+    assert got.detail == expected_detail
+    # Every synthetic assignment was admissible, even when no consequence was supported.
+    assert got.binding_evidence == (binding.SUPPORTED if parts else "")
+    assert parts == untouched_parts and partial.to_json() == untouched_binding
+
