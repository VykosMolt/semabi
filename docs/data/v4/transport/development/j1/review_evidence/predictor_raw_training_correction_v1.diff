+def public_scalar(value):
+    return value is None or type(value) in (str, bool) or io._real(value)
+
+
+def validate_training_step(row, index, observations):
+    io.require(type(row) is dict and set(row) == {
+        "step", "episode", "action", "ok", "error", "before", "after", "typed_tokens"},
+        "Raw training Step schema differs")
+    io.require(type(row["step"]) is int and row["step"] == index
+               and type(row["episode"]) is int and row["episode"] >= 0
+               and type(row["ok"]) is bool
+               and (row["error"] is None or type(row["error"]) is str), "Raw training Step values differ")
+    io.require(type(row["before"]) is str and type(row["after"]) is str
+               and row["before"] in observations and row["after"] in observations,
+               "Raw training Step signatures differ")
+    io.require(type(row["typed_tokens"]) is list and all(public_scalar(value) for value in row["typed_tokens"]),
+               "Raw training typed_tokens must retain JSON scalars")
+    primitive = row["action"]
+    io.require(type(primitive) is dict and {"kind"} <= set(primitive) <= io.PRIMITIVE_KEYS
+               and type(primitive["kind"]) is str and primitive["kind"] in io.KINDS,
+               "Raw training Primitive schema differs")
+    io.require(public_scalar(primitive.get("text")), "Raw attempted text must be a JSON scalar")
+    target = primitive.get("target")
+    descriptor = primitive.get("target_desc")
+    if target is None:
+        # The retained resolver records its ordinary failed role/name attempt;
+        # no evaluator scope, script identifier or supplied argument is accepted.
+        io.require(descriptor is None or (type(descriptor) is dict and set(descriptor) == {"role", "name"}
+                   and all(type(value) is str for value in descriptor.values())),
+                   "Raw failed-resolution descriptor differs")
+        return
+    nodes = observations[row["before"]]["nodes"]
+    io.require(type(target) is int and 0 <= target < len(nodes), "Raw target index differs")
+    io.require(type(descriptor) is dict and set(descriptor) == {"role", "name", "placeholder"}
+               and type(descriptor["role"]) is str and type(descriptor["name"]) is str
+               and (descriptor["placeholder"] is None or type(descriptor["placeholder"]) is str)
+               and io.json_bytes(descriptor) == io.json_bytes(io.public_descriptor(nodes[target])),
+               "Raw resolved descriptor differs from its public observation")
 
 
