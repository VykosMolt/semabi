+def _configured_widget_hypothesis(after_keys=("Alpha", "Beta")):
+    graph = ObsGraph()
+    sigs = []
+    for status, keys in (("Before", ("Alpha", "Beta")), ("After", after_keys)):
+        page = Observation([
+            Node(0, -1, "group", ""), Node(1, 0, "status", status), Node(2, 0, "list", ""),
