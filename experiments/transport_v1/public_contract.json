{
  "schema_version": 1,
  "suite": "transport_v1",
  "startup": {
    "command": "python experiments/transport_v1/server.py --port 8767",
    "base_url": "http://127.0.0.1:8767",
    "health_path": "/health"
  },
  "observation_policy": {
    "learner_inputs": [
      "accessibility snapshots",
      "ordered public action and observation history"
    ],
    "prohibited_learner_inputs": [
      "HTML or DOM source",
      "JavaScript or server source",
      "oracle files",
      "setup state",
      "withheld cases or outcomes"
    ],
    "snapshot_counts_as_primitive": false,
    "charged_primitives": [
      "reset",
      "reload",
      "type",
      "select",
      "click",
      "press"
    ],
    "max_acquisition_primitives": 60
  },
  "action_schema": {
    "kind": [
      "click",
      "type",
      "snapshot"
    ],
    "target_fields": [
      "role",
      "name",
      "exact"
    ],
    "text_input_field": "value",
    "type_semantics": "replace full value of field addressed by accessible role/name; dispatch input and change events",
    "exact_default": true
  },
