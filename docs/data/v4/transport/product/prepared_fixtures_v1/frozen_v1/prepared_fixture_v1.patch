+def installation(tmp_path, monkeypatch):
+    app = tmp_path / "memos"
+    (app / "data/attachments/empty").mkdir(parents=True)
+    (app / "private").mkdir(mode=0o700)
+    (app / "data/database.sqlite").write_bytes(b"SQLite format 3\0opaque synthetic database\xff")
+    (app / "data/database.sqlite-wal").write_bytes(b"opaque synthetic WAL\x00\x03")
+    (app / "data/database.sqlite-shm").write_bytes(b"opaque synthetic shared memory\x00")
+    (app / "data/attachments/picture.bin").write_bytes(bytes(range(256)))
+    (app / "data").chmod(0o700)
+    (app / "data/attachments").chmod(0o750)
+    (app / "data/attachments/empty").chmod(0o500)
+    (app / "data/database.sqlite").chmod(0o600)
+    (app / "data/database.sqlite-wal").chmod(0o600)
+    (app / "data/database.sqlite-shm").chmod(0o600)
+    (app / "data/attachments/picture.bin").chmod(0o400)
