+@pytest.mark.parametrize("budget", [{"limit": 1}, {"nodes": 2}], ids=["answers", "nodes"])
+def test_a_partial_singleton_does_not_establish_uniqueness(budget):
+    a, b = obj("A"), obj("B")
+    op, world = rule({"?z": BERTH}), state(a, b)
+    complete = binding.solve(op, (), world, {})
+    partial = binding.solve(op, (), world, {}, **budget)
+
+    assert complete.status == binding.AMBIGUOUS and not complete.truncated
+    assert len(complete.admissible) == 2
+    assert complete.effect_target(["?z"]) == (binding.UNDERDETERMINED, 2)
+    assert partial.status == binding.UNSETTLED and partial.truncated
+    assert partial and partial.unique is None
+    assert partial.admissible == complete.admissible[:1]
+    assert partial.admissible[0].get("?z") is a
+    assert partial.admissible[0].provenance == {"?z": binding.DERIVED}
+    assert partial.admissible[0].evidence == binding.SUPPORTED
+    assert partial.pinned() == frozenset()
+    assert partial.effect_target(["?z"]) == (binding.UNDETERMINED_INCOMPLETE, 1)
+    assert partial.detail == (
+        "the search stopped after 2 steps with one admissible assignment; "
+        "the enumeration is incomplete, so uniqueness is not established")
+    assert partial.to_json() == {
+        "status": binding.UNSETTLED, "truncated": True, "count": 1,
+        "detail": partial.detail, "admissible": [complete.admissible[0].to_json()]}
+
+
+@pytest.mark.parametrize("budget", [{"limit": 1}, {"nodes": 2}, {"limit": 1, "nodes": 2}],
+                         ids=["answers", "nodes", "both"])
+@pytest.mark.parametrize("pruned_tail", [False, True], ids=["one-candidate", "pruned-tail"])
+def test_a_complete_singleton_at_its_bounds_remains_unique(budget, pruned_tail):
+    a = obj("A", state="open")
+    world = state(a, obj("B", state="closed")) if pruned_tail else state(a)
+    op = rule({"?z": BERTH}, [("attr", "?z", "state", "open")])
+    found = binding.solve(op, op.pre, world, {}, **budget)
+
+    # Reaching a numeric bound is not truncation when no further extension is needed.
+    assert found.status == binding.UNIQUE and not found.truncated
+    assert len(found.admissible) == 1 and found.unique.get("?z") is a
+    assert found.pinned() == frozenset({"?z"})
+    assert found.effect_target(["?z"]) == (binding.DETERMINED, 1)
+    assert found.detail == "one assignment satisfies the rule's preconditions"
+
