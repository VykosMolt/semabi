+@pytest.mark.parametrize("gained, complete_verdict", [
+    ((), "REFUTED"), (("Alpha",), "POSSIBLE"), (("Beta",), "POSSIBLE"),
+    (("Alpha", "Beta"), "SUPPORTED"),
+], ids=["neither", "alpha-only", "beta-only", "both"])
+def test_creation_deduplication_does_not_complete_a_partial_search(budget, gained,
+                                                                complete_verdict):
+    from copy import deepcopy
+    from semabi.compiler.observation import Node, Observation
+    from semabi.compiler.v4 import consequence as csq
+
+    op = rule({"?z": BERTH, "?w": CALL, "?new0": 3})
+    world = state(obj("Alpha"), obj("Beta"), obj("w0", tid=CALL), obj("w1", tid=CALL))
+    eff = SimpleNamespace(kind="add", obj="?new0", attrs=(("value", "?z"),), refs=())
+    bound = binding.solve(op, (), world, {}, **budget)
+    representatives = csq._distinct_by(bound.admissible,
+                                       lambda assignment: csq._creation_values(eff, assignment))
+    expected_keys = ["Alpha"] if budget else ["Alpha", "Beta"]
+    assert [a.get("?z").key for a in representatives] == expected_keys
+    assert len(bound.admissible) == (2 if budget else 4)
+    assert bound.truncated == bool(budget)
+    assert bound.effect_target(["?z"]) == ((binding.UNDETERMINED_INCOMPLETE, 1) if budget
+                                           else (binding.UNDERDETERMINED, 2))
+    before = Observation([Node(0, -1, "document", "")])
+    after = Observation([Node(0, -1, "document", "")] +
+                        [Node(i, 0, "text", value) for i, value in enumerate(gained, 1)])
+    base = _part(csq.NOT_APPLICABLE)
+    base.kind = csq.CREATION
+    base.bindings, base.binding_status = len(bound.admissible), bound.status
+    base.binding_truncated = bound.truncated
+    parts = [csq._under_one_binding(base, None, {}, before, after, None, op, eff,
+                                    assignment, None, None, {}, "new")
+             for assignment in representatives]
+    assert [p.verdict for p in parts] == [csq.SUPPORTED if key in gained else csq.REFUTED
+                                         for key in expected_keys]
+    assert [p.expected for p in parts] == expected_keys
+    assert [p.observed for p in parts] == [(f"{int(key in gained)} after",)
+                                          for key in expected_keys]
+    original_parts, original_binding = deepcopy(parts), bound.to_json()
+    got = csq._aggregate(base, parts, bound)
+    assert got.verdict == (csq.POSSIBLE if budget else complete_verdict)
+    assert got.binding_truncated == bool(budget)
+    assert got.expected == "Alpha" and got.observed == parts[0].observed
+    assert got.held_before == "0 structures carried these values before"
+    if budget:
+        assert "2 assignments retained; 1 representative consequences evaluated" in got.detail
+        assert f"SUPPORTED={int('Alpha' in gained)}" in got.detail
+        assert f"REFUTED={int('Alpha' not in gained)}" in got.detail
+        assert f"representative evidence: {parts[0].detail}" in got.detail
+    assert parts == original_parts and bound.to_json() == original_binding
+
