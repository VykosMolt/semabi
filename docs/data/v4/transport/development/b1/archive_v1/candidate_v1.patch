+def test_score_abstains_on_a_partial_singleton(monkeypatch):
+    from semabi.compiler.v4 import consequence as csq
+
+    world = state(obj("A"), obj("B"))
+    op = rule({"?z": BERTH})
+    op.name, op.positives, op.unexplained_negatives = "partial", (), 0
+    op.effs = [SimpleNamespace(kind="set", obj="?z", slot="attr:state", new="closed")]
+    op.core = lambda: (SimpleNamespace(kind="click", owner=None,
+                                       loc=SimpleNamespace(slot="button:Act", owner_tid=None)),)
+    observations = {"before": object(), "after": object()}
+    step = SimpleNamespace(step=0, before="before", after="after",
+                           action=SimpleNamespace(kind="click", target=0))
+    abstractor = SimpleNamespace(types=world.types, abstract=lambda obs: world,
+                                 parsed=lambda obs: None,
+                                 control_family=lambda obs: {0: "button:Act"})
+    model = SimpleNamespace(abstractor=abstractor, operators=[op], cut=0, split=0.0,
+                            reading=SimpleNamespace(name="synthetic"), regime=csq.FROZEN_PREFIX,
+                            queries={}, log=SimpleNamespace(steps=[step],
+                                                            obs=observations.__getitem__))
+    native_solve, retained = binding.solve, []
+
+    def limited_solve(*args, **kwargs):
+        bound = native_solve(*args, **kwargs, limit=1)
+        retained.append(bound)
+        return bound
+
+    def unexpected_consequence(*args, **kwargs):
+        pytest.fail("an incomplete singleton must abstain before evaluating its consequence")
+
+    monkeypatch.setattr(binding, "solve", limited_solve)
+    monkeypatch.setattr(csq, "slot_nodes", lambda *args: {})
+    monkeypatch.setattr(csq, "_under_one_binding", unexpected_consequence)
+    result = csq.score(model)
+    assert len(retained) == 1 and retained[0].status == binding.UNSETTLED
+    assert len(result.predictions) == 1
+    prediction = result.predictions[0]
+    assert prediction.verdict == csq.UNKNOWN and prediction.binding_truncated
+    assert prediction.bindings == 1 and prediction.binding_status == binding.UNSETTLED
+    assert prediction.detail == retained[0].detail
+    assert prediction.identity is None and prediction.context == ()
+    assert result.binding_summary()["hit_the_enumeration_bound"] == 1
+
